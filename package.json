{
	"name": "obsidian-simple-templates-plugin",
	"version": "0.1.1",
	"packageManager": "bun@1.4.0",
	"description": "Insert reusable templates into Obsidian notes.",
	"main": "main.js",
	"scripts": {
		"dev": "vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --report-unused-disable-directives",
		"lint:fix": "eslint . --fix --report-unused-disable-directives",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run lint && bun run test",
		"release": "bun run release:prepare",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"verify": "bun run check && bun run build && lemons-automation validate",
		"release:prepare": "lemons-automation release:prepare",
		"package": "bun run build && lemons-automation package",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.8/automation-v0.2.8.tgz",
		"@lemons_dev/obsidian-safe-js-api": "https://github.com/mProjectsCode/obsidian-safe-js-plugin/releases/download/0.3.0/obsidian-safe-js-api.tgz",
		"@types/bun": "1.3.14",
		"eslint": "9.39.4",
		"obsidian": "1.13.1",
		"prettier": "3.9.4",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.5/eslint-config-v0.1.5.tgz",
		"@types/node": "25.5.0"
	},
	"dependencies": {
		"@lemons_dev/parsinom": "^0.2.1",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
